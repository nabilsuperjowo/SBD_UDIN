# Contoh koneksi, bukan konfigurasi aktif. Jangan mengunggah password ke Git/percakapan.
# Ambil HOST, PORT, USERNAME dari Supabase > Connect > Session pooler.
# Salin nilai DB_* ini ke .env aktif hanya sesudah data tujuan diperiksa.
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.kbnbnvunyuwtilidinum
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require
DB_EMULATE_PREPARES=false

# Pertahankan APP_KEY aplikasi yang sudah ada.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
